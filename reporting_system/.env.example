# Flask Configuration
# Copy this file to .env and update the values

# Flask environment (development, production, testing)
FLASK_CONFIG=development
FLASK_DEBUG=1

# Secret key for session signing (generate a secure random key for production)
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production

# Database URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@host:port/database_name

# Test database (for running tests)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reporting_system_test

# Cloudflare R2 (S3-compatible)
# Create these in Cloudflare Dashboard -> R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_REGION=auto
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL_BASE=https://pub-your-public-bucket-id.r2.dev
